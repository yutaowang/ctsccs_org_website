{
  "expo": {
    "name": "SCCS",
    "slug": "sccs-mobile",
    "scheme": "sccs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.ctsccs.mobile"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F0BF32",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "org.ctsccs.mobile",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-web-browser",
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e9f8bec-0f50-48c3-84d7-c7571c51718f"
      }
    },
    "owner": "ywang9"
  }
}
