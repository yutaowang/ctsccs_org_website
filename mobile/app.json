{
  "expo": {
    "name": "SCCS",
    "slug": "sccs-mobile",
    "scheme": "sccs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.ctsccs.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0BF32",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "org.ctsccs.mobile",
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router", "expo-notifications", "expo-web-browser", "expo-sqlite"],
    "experiments": { "typedRoutes": true },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-sqlite"
    ]
  }
}
